# ==============================================================================
# Restock-Predictor Environment Configuration (.env)
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=

# Optional MongoDB Database and Collection Overrides
MONGO_DB_NAME=restock_predictor
MONGO_COLLECTION_NAME=upload_logs

# Prior Labs TabPFN API Token / Key
# Obtain from https://platform.priorlabs.ai/account/api-keys
TABPFN_API_KEY=
